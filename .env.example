# MST Blockchain Network Selection (mainnet | coral)
NETWORK=mainnet

# MST Blockchain Mainnet Configuration (Chain ID: 4646 / 0x1226)
MST_MAINNET_RPC_URL=https://mariorpc.mstblockchain.com
MST_MAINNET_CHAIN_ID=4646

# MST Coral Testnet Configuration (Chain ID: 54635 / 0xd56b)
CORAL_RPC_URL=https://coralrpc.mstblockchain.com
CORAL_CHAIN_ID=54635

# Deployer Private Key for CLI deployment (Hold real MSTC for mainnet deployment)
# DO NOT COMMIT PRIVATE KEYS
PRIVATE_KEY=

# Deployed BugBountyEscrow Contract Address
ESCROW_CONTRACT_ADDRESS=

# Backend API Configuration
PORT=4000
CORS_ORIGIN=*
NODE_ENV=production

# Frontend Configuration
VITE_NETWORK=mainnet
VITE_ESCROW_CONTRACT_ADDRESS=
VITE_BACKEND_API_URL=http://localhost:4000/api
