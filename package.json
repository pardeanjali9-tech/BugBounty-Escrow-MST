{
  "name": "veil-bugbounty-escrow-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "VEIL — BugBounty Escrow on MST Coral Testnet with BridgeKey",
  "workspaces": [
    "frontend",
    "backend",
    "contracts"
  ],
  "scripts": {
    "build": "npm install --prefix frontend && npm run build --prefix frontend",
    "test:contracts": "npm run test --prefix contracts",
    "test:backend": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test:all": "npm run test:contracts && npm run test:backend && npm run test:frontend",
    "verify:mainnet": "npm run verify:mainnet --prefix contracts",
    "deploy:mainnet": "npm run deploy:mainnet --prefix contracts",
    "build:contracts": "npm run compile --prefix contracts",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:all": "npm run build:contracts && npm run build:backend && npm run build:frontend",
    "start:backend": "npm run dev --prefix backend",
    "start:frontend": "npm run dev --prefix frontend"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.11.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "bugbounty",
    "escrow",
    "mst-coral",
    "bridgekey",
    "privacy",
    "smart-contracts"
  ],
  "author": "VEIL Protocol",
  "license": "MIT"
}

